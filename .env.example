# Copy this file to .env and fill in the values before starting the server.

# Required on Vercel - signs proxy URLs (use any long random string)
PROXY_SECRET=

# off = episodes use embed player (recommended for public deployments)
# on  = native HLS relay (for self-hosted / local dev)
PLAYZANIME_RELAY=off

# Public address of this server when the frontend is hosted elsewhere (e.g. GitHub Pages)
PUBLIC_URL=

# Comma-separated origins allowed to call this server
# Example: https://yourname.github.io,https://yourdomain.com
ALLOWED_ORIGINS=

# Override the default port (default: 5310)
# PORT=5310

# Bind address (default: 127.0.0.1 - set to 0.0.0.0 for Docker or VPS)
# HOST=127.0.0.1

