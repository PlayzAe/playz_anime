{
  "name": "playzanime-web",
  "version": "0.1.0",
  "description": "PlayzAnime in the browser: watch anime and read manga, manhwa and manhua.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "vite build && npm --prefix server run build:vercel",
    "build:pages": "vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "lint": "oxlint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "author": {
    "name": "PlayzAnime"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "hls.js": "^1.7.3",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
